# ============================================================================
# SOLOB+ Environment Configuration Example (PLACEHOLDERS ONLY - NO SECRETS)
# ============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Configuration
# Option A: External PostgreSQL server (required for multi-instance production)
# DATABASE_URL=postgresql://solob_user:REPLACE_WITH_DB_PASSWORD@localhost:5432/solob_plus
# Option B: Embedded PostgreSQL 16 via PGlite data directory (default when DATABASE_URL is unset)
PGLITE_DATA_DIR=./data/pgdata

# Authentication & Session Security (Mandatory in production; min 32 high-entropy chars)
# Generate with: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_64_CHAR_HEX_SESSION_SECRET_DO_NOT_COMMIT
SESSION_TTL_HOURS=24

# Initial Production Admin One-Time Bootstrap (scripts/bootstrap-admin.ts)
# Run once: npm run db:bootstrap-admin, then REMOVE these variables from the environment.
# Concurrent/re-runs are refused (transaction + advisory lock + system_bootstrap singleton, migration 003).
# BOOTSTRAP_ADMIN_EMAIL=admin@your-domain.org
# BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_PASSWORD_MIN_12_CHARS
# BOOTSTRAP_ADMIN_NAME=SOLOB Production Administrator
# BOOTSTRAP_ADMIN_COUNTRY=BJ

# Reverse Proxy & Distributed Rate-Limiting Trust Configuration
# Set TRUST_PROXY=true ONLY behind a reverse proxy that (1) strips any client-supplied
# x-solob-proxy-secret header, (2) injects its own x-solob-proxy-secret: <TRUSTED_PROXY_SECRET>,
# and (3) appends the peer address to X-Forwarded-For. Forwarding headers are ignored unless the
# x-solob-proxy-secret header matches (constant-time comparison).
# Production + TRUST_PROXY=true REQUIRES TRUSTED_PROXY_SECRET (>= 32 high-entropy chars) or startup fails.
# TRUSTED_PROXY_HOPS = number of trusted proxies appending to X-Forwarded-For (positive integer 1..10).
# Generate with: openssl rand -hex 32
TRUST_PROXY=false
TRUSTED_PROXY_HOPS=1
TRUSTED_PROXY_SECRET=

# Rate limiting (shared PostgreSQL table rate_limit_buckets, atomic upsert).
# If PostgreSQL is unavailable: production fails closed (503 RATE_LIMIT_UNAVAILABLE).
# Dev/test fall back to per-instance memory unless set to false. Setting true in production is rejected at startup.
# RATE_LIMIT_ALLOW_MEMORY_FALLBACK=false

# Private Object Storage Configuration
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./data/storage
MAX_UPLOAD_BYTES=10485760

# AI Provider Integration (Server-side only)
# Leave AI_API_KEY empty to run in explicit, non-deceptive DEMO / MOCK MODE
AI_PROVIDER=mock
AI_MODEL=solob-grounded-tutor-v1
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2
AI_RATE_LIMIT_PER_MINUTE=30

# Payment Provider Configuration (Disabled until verified legal & sandbox setup)
PAYMENT_PROVIDER=disabled
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
