# ============================================================================
# SOLOB+ Environment Configuration Example (PLACEHOLDERS ONLY - NO SECRETS)
# ============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Configuration
# Option A: External PostgreSQL server (required for multi-instance production)
# DATABASE_URL=postgresql://solob_user:REPLACE_WITH_DB_PASSWORD@localhost:5432/solob_plus
# Option B: Embedded PostgreSQL 16 via PGlite data directory (default when DATABASE_URL is unset)
PGLITE_DATA_DIR=./data/pgdata

# Authentication & Session Security (Mandatory in production; min 32 high-entropy chars)
# Generate with: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_64_CHAR_HEX_SESSION_SECRET_DO_NOT_COMMIT
SESSION_TTL_HOURS=24

# Initial Production Admin One-Time Bootstrap (scripts/bootstrap-admin.ts)
# INITIAL_ADMIN_EMAIL=admin@your-domain.org
# INITIAL_ADMIN_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_PASSWORD_MIN_12_CHARS
# INITIAL_ADMIN_FULL_NAME=SOLOB Production Administrator
# INITIAL_ADMIN_COUNTRY=BJ

# Reverse Proxy & Distributed Rate-Limiting Trust Configuration
# Set TRUST_PROXY=true ONLY when running behind a reverse proxy that strips/overwrites forwarding headers.
TRUST_PROXY=false
TRUSTED_PROXY_HOPS=1
TRUSTED_PROXY_SECRET=

# Private Object Storage Configuration
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./data/storage
MAX_UPLOAD_BYTES=10485760

# AI Provider Integration (Server-side only)
# Leave AI_API_KEY empty to run in explicit, non-deceptive DEMO / MOCK MODE
AI_PROVIDER=mock
AI_MODEL=solob-grounded-tutor-v1
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2
AI_RATE_LIMIT_PER_MINUTE=30

# Payment Provider Configuration (Disabled until verified legal & sandbox setup)
PAYMENT_PROVIDER=disabled
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
